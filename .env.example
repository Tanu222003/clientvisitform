# ==============================================================================
# Environment Configuration Template
# ==============================================================================

# Frontend (Vercel) Environment Variables:
# In development (Vite dev server default: port 5173 -> proxies or calls localhost:5001)
# In production on Vercel: set to '/api' so vercel.json rewrites proxy requests to Railway
VITE_API_URL=/api

# Optional: Direct Railway backend URL (fallback if Vercel edge rewrite is unavailable)
VITE_BACKEND_URL=https://park-solitaire-crm-production.up.railway.app/api
VITE_RAILWAY_URL=https://park-solitaire-crm-production.up.railway.app/api

# Backend (Railway) Environment Variables:
# PORT is automatically injected by Railway (e.g., 8080 or random port)
PORT=5001
NODE_ENV=production

# Database (Optional on Railway):
# If PostgreSQL is provisioned on Railway, Railway sets DATABASE_URL automatically:
# DATABASE_URL=postgresql://postgres:password@host:port/railway
# If DATABASE_URL is not set, backend automatically persists data to server/data/*.json
DATA_DIR=./server/data
